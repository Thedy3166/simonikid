# ============================================================
# SIMONIK Backend - Environment Variables (Example)
# Salin ke `.env` (lokal) atau isi di Vercel > Settings > Environment Variables
# JANGAN commit nilai asli.
# ============================================================

PORT=3000

# Lokal : postgres://postgres:PASSWORD@localhost:5432/simonik
# Supabase (Transaction pooler, port 6543):
# postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:6543/postgres
# Catatan: karakter khusus pada password harus di-URL-encode.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:6543/postgres

# String acak panjang. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Supabase Storage (untuk upload foto)
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY
SUPABASE_BUCKET=simonik-uploads

# URL frontend yang boleh memanggil API (kosong = semua origin, hanya untuk lokal)
CORS_ORIGIN=https://<FRONTEND-DOMAIN>.vercel.app
